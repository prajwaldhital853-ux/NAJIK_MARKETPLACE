# Copy to .env.local for optional overrides during local development.
#
# API URL is chosen automatically:
#   localhost:3000  -> http://127.0.0.1:8000
#   Vercel domain   -> https://najik-api-p9k2m7q.onrender.com
#
# You usually do NOT need to set NEXT_PUBLIC_API_URL locally.
# For Vercel builds, .env.production is committed with the Render URL.

# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

