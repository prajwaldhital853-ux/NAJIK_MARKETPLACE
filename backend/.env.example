# Copy to .env and keep it out of git.

DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
JWT_SIGNING_KEY=change-me-to-a-different-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,192.168.1.3

# PostgreSQL is required locally and in production. SQLite is not used.
DATABASE_URL=postgres://najik:CHANGE_ME@127.0.0.1:5432/najik

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
