# Render: copy these into the Web Service → Environment.
# Replace placeholders with real values from your Render Postgres + Vercel URLs.

DEBUG=False
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_SIGNING_KEY=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET

# Your Render web service hostname (no https://). Add custom domain later if any.
ALLOWED_HOSTS=najik-api.onrender.com

# Paste Internal Database URL from Render Postgres (same account/region).
# Example: postgres://najik_user:xxxx@dpg-xxxxx-a/najik
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME

# Vercel admin + any other browser origins that call the API (comma-separated, no spaces needed).
CORS_ALLOWED_ORIGINS=https://YOUR-ADMIN.vercel.app
CSRF_TRUSTED_ORIGINS=https://YOUR-ADMIN.vercel.app

# Keep True while using stub OTP for feedback; set False when real SMS/email OTP is wired.
OTP_STUB=True

# Google OAuth (same client IDs as mobile / Google Cloud Console)
GOOGLE_CLIENT_IDS=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com,YOUR_ANDROID_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_WEB_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://auth.expo.io/@prajwal851/najik

# Render terminates HTTPS; leave True once SECURE_PROXY_SSL_HEADER is in settings.
SECURE_SSL_REDIRECT=True

# Optional: force Django to use a specific media path on a Render persistent disk.
# If unset, media is stored under backend/media on the service disk.
# MEDIA_ROOT=/var/data/media
